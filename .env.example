# Server
PORT=3000
# Bind address. Keep 127.0.0.1 so the app is only reachable from this computer.
HOST=127.0.0.1
# SQLite file (relative to apps/server/prisma)
DATABASE_URL="file:../data/theater.db"

# TMDB: get a free key at https://www.themoviedb.org/settings/api
# Either the v3 API key or the v4 "API Read Access Token" works.
TMDB_API_KEY=
